{
  "name": "comet-editor-vendor",
  "private": true,
  "description": "把 CodeMirror 打包成 platform/web/vendor/codemirror.js 用。平常不需要執行。",
  "scripts": {
    "build": "esbuild entry.js --bundle --format=esm --minify --legal-comments=eof --outfile=../../platform/web/vendor/codemirror.js"
  },
  "devDependencies": {
    "codemirror": "6.0.2",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.14",
    "esbuild": "^0.25.0"
  }
}
