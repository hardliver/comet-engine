--- a/src/host/usbh.c
+++ b/src/host/usbh.c
@@ -1410,8 +1410,9 @@
 
       // Get first 8 bytes of device descriptor for Control Endpoint size
       TU_LOG_USBH("Get 8 byte of Device Descriptor\r\n");
-      TU_ASSERT(tuh_descriptor_get_device(addr0, _usbh_epbuf.ctrl, 8,
-                                          process_enumeration, ENUM_SET_ADDR),);
+      // Nova: ask for 64 bytes like Windows does (some receivers pick their identity from this)
+      TU_ASSERT(tuh_descriptor_get(addr0, TUSB_DESC_DEVICE, 0, _usbh_epbuf.ctrl, 64,
+                                   process_enumeration, ENUM_SET_ADDR),);
       break;
     }
 
@@ -1480,7 +1481,7 @@
       // Get 9-byte for total length
       uint8_t const config_idx = CONFIG_NUM - 1;
       TU_LOG_USBH("Get Configuration[0] Descriptor (9 bytes)\r\n");
-      TU_ASSERT(tuh_descriptor_get_configuration(daddr, config_idx, _usbh_epbuf.ctrl, 9,
+      TU_ASSERT(tuh_descriptor_get_configuration(daddr, config_idx, _usbh_epbuf.ctrl, 255,   /* Nova: Windows asks for 255 */
                                                  process_enumeration, ENUM_GET_FULL_CONFIG_DESC),);
       break;
     }
@@ -1542,6 +1543,14 @@
 
   if (_dev0.hub_addr == 0) {
     // connected directly to roothub
+    // Nova: like Windows (and USB 2.0 spec 7.1.7.3, TATTDB = 100 ms), wait for the connection
+    // to settle before the bus reset. Some receivers re-attach while switching identity and
+    // fall back to their update-mode identity if reset immediately.
+    tusb_time_delay_ms_api(100);
+    if (!hcd_port_connect_status(_dev0.rhport)) {
+      enum_full_complete();
+      return true;
+    }
     hcd_port_reset(_dev0.rhport);
 
     // Since we are in middle of rhport reset, frame number is not available yet.
